{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "automationDetails": {
        "id": "dast-openapi/"
      },
      "invocations": [
        {
          "executionSuccessful": true,
          "toolExecutionNotifications": [
            {
              "descriptor": {
                "id": "not-checked"
              },
              "level": "warning",
              "message": {
                "text": "hosts: controls off: headers, tls"
              },
              "properties": {
                "component": "dast-openapi",
                "controls": [
                  "headers",
                  "tls"
                ],
                "kind": "not-checked"
              }
            },
            {
              "descriptor": {
                "id": "not-checked"
              },
              "level": "warning",
              "message": {
                "text": "repositories: controls off: iac, sast, sca, secrets"
              },
              "properties": {
                "component": "dast-openapi",
                "controls": [
                  "iac",
                  "sast",
                  "sca",
                  "secrets"
                ],
                "kind": "not-checked"
              }
            }
          ]
        }
      ],
      "properties": {
        "draugr/provenance": [
          {
            "fields": {
              "endpoint": "http://127.0.0.1:18080",
              "excluded": "1 operation not scanned: delete (1)",
              "methods": "get, head",
              "operations": "1",
              "spec": "./dast-openapi/openapi.yaml"
            },
            "tool": "nuclei"
          }
        ]
      },
      "results": [
        {
          "level": "warning",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "http://127.0.0.1:18080/items?q=all-sealed"
                }
              }
            }
          ],
          "message": {
            "text": "Sealed fixture debug field in an API response: The response carries the debug marker the sealed fixture plants."
          },
          "properties": {
            "component": "dast-openapi",
            "control": "dast",
            "fingerprint": "<cleared>",
            "priority": "P2",
            "security-severity": "5",
            "tool": "nuclei"
          },
          "ruleId": "sealed-debug-exposure"
        }
      ],
      "tool": {
        "driver": {
          "name": "Draugr",
          "rules": [
            {
              "id": "sealed-debug-exposure",
              "properties": {
                "tags": [
                  "scanner:nuclei"
                ]
              }
            }
          ],
          "version": "<cleared>"
        }
      }
    }
  ],
  "version": "2.1.0"
}
