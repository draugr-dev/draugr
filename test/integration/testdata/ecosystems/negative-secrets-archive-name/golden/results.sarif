{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "automationDetails": {
        "id": "negative-secrets-archive-name/"
      },
      "invocations": [
        {
          "executionSuccessful": true,
          "toolExecutionNotifications": [
            {
              "descriptor": {
                "id": "unread-files"
              },
              "level": "warning",
              "locations": [
                {
                  "physicalLocation": {
                    "artifactLocation": {
                      "uri": "notes.zip.txt",
                      "uriBaseId": "%SRCROOT%"
                    }
                  },
                  "properties": {
                    "repository": "./negative-secrets-archive-name"
                  }
                }
              ],
              "message": {
                "text": "notes.zip.txt: name has an archive extension"
              },
              "properties": {
                "component": "negative-secrets-archive-name",
                "controls": [
                  "secrets"
                ],
                "kind": "unread-files"
              }
            },
            {
              "descriptor": {
                "id": "unread-files"
              },
              "level": "warning",
              "locations": [
                {
                  "physicalLocation": {
                    "artifactLocation": {
                      "uri": "release.brief.md",
                      "uriBaseId": "%SRCROOT%"
                    }
                  },
                  "properties": {
                    "repository": "./negative-secrets-archive-name"
                  }
                }
              ],
              "message": {
                "text": "release.brief.md: name has an archive extension"
              },
              "properties": {
                "component": "negative-secrets-archive-name",
                "controls": [
                  "secrets"
                ],
                "kind": "unread-files"
              }
            }
          ]
        }
      ],
      "originalUriBaseIds": {
        "%SRCROOT%": {
          "description": {
            "text": "The root of the scanned source tree."
          }
        }
      },
      "properties": {
        "draugr/provenance": [
          {
            "fields": {
              "repository": "./negative-secrets-archive-name",
              "revision": "<cleared>"
            },
            "tool": "gitleaks",
            "version": "<cleared>"
          }
        ]
      },
      "results": [
        {
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "config/aws.env",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
          ],
          "message": {
            "text": "aws-access-token has detected secret for file config/aws.env."
          },
          "partialFingerprints": {
            "primaryLocationLineHash/v1": "<cleared>"
          },
          "properties": {
            "component": "negative-secrets-archive-name",
            "control": "secrets",
            "draugr/rating": {
              "fields": {
                "level": "warning"
              },
              "severity": "medium"
            },
            "fingerprint": "<cleared>",
            "priority": "P1",
            "repository": "./negative-secrets-archive-name",
            "severityFloor": "high",
            "tool": "gitleaks"
          },
          "ruleId": "aws-access-token"
        }
      ],
      "tool": {
        "driver": {
          "name": "Draugr",
          "rules": [
            {
              "id": "aws-access-token",
              "properties": {
                "tags": [
                  "scanner:gitleaks"
                ]
              },
              "shortDescription": {
                "text": "Identified a pattern that may indicate AWS credentials, risking unauthorized cloud resource access and data breaches on AWS platforms."
              }
            }
          ],
          "version": "<cleared>"
        }
      }
    }
  ],
  "version": "2.1.0"
}
