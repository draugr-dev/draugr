{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "automationDetails": {
        "id": "monorepo-secret-history/"
      },
      "originalUriBaseIds": {
        "%SRCROOT%": {
          "description": {
            "text": "The root of the scanned source tree."
          }
        }
      },
      "properties": {
        "draugr/provenance": [
          {
            "component": "api",
            "fields": {
              "controls": "[\"secrets\"]",
              "criticality": "",
              "exposure": "",
              "repositories": "[\"./monorepo-secret-history\"]",
              "repositoryScopes": "[{\"url\":\"./monorepo-secret-history\",\"paths\":[\"services/api\"]}]"
            },
            "tool": "draugr/declared"
          },
          {
            "component": "web",
            "fields": {
              "controls": "[\"secrets\"]",
              "criticality": "",
              "exposure": "",
              "repositories": "[\"./monorepo-secret-history\"]",
              "repositoryScopes": "[{\"url\":\"./monorepo-secret-history\",\"paths\":[\"services/web\"]}]"
            },
            "tool": "draugr/declared"
          },
          {
            "fields": {
              "controls": "[]",
              "exclusions": "[]"
            },
            "tool": "draugr/declared"
          },
          {
            "fields": {
              "repository": "./monorepo-secret-history",
              "revision": "<cleared>"
            },
            "tool": "gitleaks",
            "version": "<cleared>"
          }
        ]
      },
      "results": [
        {
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "services/api/old.env",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
          ],
          "message": {
            "text": "aws-access-token has detected secret for file services/api/old.env at commit <commit>."
          },
          "partialFingerprints": {
            "commitSha": "<commit>"
          },
          "properties": {
            "component": "api",
            "control": "secrets",
            "draugr/rating": {
              "fields": {
                "level": "warning"
              },
              "severity": "medium"
            },
            "fingerprint": "<cleared>",
            "historical": true,
            "priority": "P1",
            "repository": "./monorepo-secret-history",
            "scanner": "gitleaks",
            "severityFloor": "high",
            "tool": "gitleaks"
          },
          "ruleId": "aws-access-token"
        },
        {
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "services/web/old.env",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
          ],
          "message": {
            "text": "aws-access-token has detected secret for file services/web/old.env at commit <commit>."
          },
          "partialFingerprints": {
            "commitSha": "<commit>"
          },
          "properties": {
            "component": "web",
            "control": "secrets",
            "draugr/rating": {
              "fields": {
                "level": "warning"
              },
              "severity": "medium"
            },
            "fingerprint": "<cleared>",
            "historical": true,
            "priority": "P1",
            "repository": "./monorepo-secret-history",
            "scanner": "gitleaks",
            "severityFloor": "high",
            "tool": "gitleaks"
          },
          "ruleId": "aws-access-token"
        }
      ],
      "tool": {
        "driver": {
          "name": "Draugr",
          "rules": [
            {
              "id": "aws-access-token",
              "properties": {
                "tags": [
                  "scanner:gitleaks"
                ]
              },
              "shortDescription": {
                "text": "Identified a pattern that may indicate AWS credentials, risking unauthorized cloud resource access and data breaches on AWS platforms."
              }
            }
          ],
          "version": "<cleared>"
        }
      }
    }
  ],
  "version": "2.1.0"
}
