{
  "name": "sealed-npm-workspace",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "sealed-npm-workspace",
      "version": "1.0.0",
      "license": "Apache-2.0",
      "workspaces": [
        "packages/*"
      ]
    },
    "node_modules/@sealed/cli": {
      "resolved": "packages/cli",
      "link": true
    },
    "node_modules/@sealed/web": {
      "resolved": "packages/web",
      "link": true
    },
    "node_modules/minimist": {
      "version": "1.2.5",
      "resolved": "https://registry.npmjs.org/minimist/-/minimist-1.2.5.tgz",
      "integrity": "sha512-FM9nNUYrRBAELZQT3xeZQ7fmMOBg6nWNmJKTcgsJeaLstP/UODVpGsr5OhXhhXg6f+qtJ8uiZ+PUxkDWcgIXLw==",
      "license": "MIT"
    },
    "packages/cli": {
      "name": "@sealed/cli",
      "version": "1.0.0",
      "license": "Apache-2.0"
    },
    "packages/web": {
      "name": "@sealed/web",
      "version": "1.0.0",
      "license": "Apache-2.0",
      "dependencies": {
        "minimist": "1.2.5"
      }
    }
  }
}
