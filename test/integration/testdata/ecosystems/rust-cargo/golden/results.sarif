{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "automationDetails": {
        "id": "rust-cargo/"
      },
      "originalUriBaseIds": {
        "%SRCROOT%": {
          "description": {
            "text": "The root of the scanned source tree."
          }
        }
      },
      "properties": {
        "draugr/provenance": [
          {
            "fields": {
              "repository": "./rust-cargo",
              "revision": "<cleared>"
            },
            "tool": "trivy-fs",
            "version": "<cleared>"
          }
        ]
      },
      "results": [
        {
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Cargo.lock",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 12
                }
              }
            }
          ],
          "message": {
            "text": "smallvec 1.6.0 → 1.6.1: Fixture: buffer overflow in SmallVec::insert_many"
          },
          "partialFingerprints": {
            "primaryLocationLineHash/v1": "<cleared>"
          },
          "properties": {
            "component": "rust-cargo",
            "control": "sca",
            "package": {
              "ecosystem": "cargo",
              "fixedVersion": "1.6.1",
              "name": "smallvec",
              "purl": "pkg:cargo/smallvec@1.6.0",
              "version": "1.6.0"
            },
            "priority": "P1",
            "repository": "./rust-cargo",
            "tool": "trivy"
          },
          "ruleId": "CVE-2021-25900"
        }
      ],
      "tool": {
        "driver": {
          "name": "Draugr",
          "rules": [
            {
              "fullDescription": {
                "text": "Fixture advisory for Draugr's sealed tests."
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2021-25900",
              "id": "CVE-2021-25900",
              "name": "CVE-2021-25900",
              "properties": {
                "tags": [
                  "scanner:trivy"
                ]
              },
              "shortDescription": {
                "text": "Fixture: buffer overflow in SmallVec::insert_many"
              }
            }
          ],
          "version": "<cleared>"
        }
      }
    }
  ],
  "version": "2.1.0"
}
