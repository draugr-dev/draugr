          },
          {
            "fields": {
              "repository": "./diff-across-releases",
              "revision": "<cleared>"
            },
            "tool": "gitleaks",
            "version": "<cleared>"
          },
          {
            "fields": {
              "repository": "./diff-across-releases",
              "revision": "<cleared>"
            },
            "tool": "semgrep",
            "version": "<cleared>"
          },
          {
            "fields": {
              "repository": "./diff-across-releases",
              "revision": "<cleared>"
            },
            "tool": "trivy-fs",
            "version": "<cleared>"
          }
        ]
      },
      "results": [
        {
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app.py",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 7
                }
              }
            }
          ],
          "message": {
            "text": "os.popen runs its argument through a shell"
          },
          "partialFingerprints": {
            "primaryLocationLineHash/v1": "<cleared>"
          },
          "properties": {
            "component": "diff-across-releases",
            "control": "sast",
            "fingerprint": "<cleared>",
            "priority": "P1",
            "repository": "./diff-across-releases",
            "scanner": "semgrep",
            "tool": "Semgrep OSS"
          },
          "ruleId": "draugr-fixture-os-popen"
        },
        {
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "requirements.txt",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 2
                }
              }
            }
          ],
          "message": {
            "text": "Flask 0.12.2 → 0.12.3: Fixture: flask denial of service through crafted JSON"
          },
          "partialFingerprints": {
            "primaryLocationLineHash/v1": "<cleared>"
          },
          "properties": {
            "component": "diff-across-releases",
            "control": "sca",
            "fingerprint": "<cleared>",
            "package": {
