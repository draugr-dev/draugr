              "controls": "[\"sast\",\"sca\",\"secrets\"]",
              "criticality": "",
              "exposure": "",
              "repositories": "[\"./diff-across-releases\"]",
              "repositoryScopes": "[{\"url\":\"./diff-across-releases\"}]",
              "settings": "{\"sast\":{\"semgrep\":\"b7dc266d05bfd164\"}}"
            },
            "tool": "draugr/declared"
          },
          {
            "fields": {
              "controls": "[]",
              "exclusions": "[]",
              "files": "[{\"kind\":\"scanner\",\"repository\":\"./diff-across-releases\",\"path\":\".gitleaksignore\",\"digests\":[\"55074968dc1ca9ca\"]},{\"kind\":\"scanner\",\"repository\":\"./diff-across-releases\",\"path\":\".semgrepignore\",\"digests\":[\"e15b1b0e0f10012a\"]},{\"kind\":\"scanner\",\"repository\":\"./diff-across-releases\",\"path\":\".trivyignore\",\"digests\":[\"61601e0746629e58\"]},{\"kind\":\"scanner\",\"repository\":\"./diff-across-releases\",\"path\":\"src/.semgrepignore\",\"digests\":[\"eb3534267ee5aaa2\"]},{\"kind\":\"setting\",\"path\":\"${{ DRAUGR_SEALED_SEMGREP_RULES }}\",\"digests\":[\"82dc0775f01c4de0\"]}]"
            },
            "tool": "draugr/declared"
          },
          {
            "fields": {
              "failOnNew": "P1"
            },
