              "fixedVersion": "0.12.3",
              "name": "Flask",
              "purl": "pkg:pypi/flask@0.12.2",
              "version": "0.12.2"
            },
            "priority": "P1",
            "repository": "./diff-across-releases",
            "scanner": "trivy-fs",
            "tool": "trivy"
          },
          "ruleId": "CVE-2018-1000656"
        }
      ],
      "tool": {
        "driver": {
          "name": "Draugr",
          "rules": [
            {
              "fullDescription": {
                "text": "Fixture advisory for Draugr's sealed tests."
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2018-1000656",
              "id": "CVE-2018-1000656",
              "name": "CVE-2018-1000656",
