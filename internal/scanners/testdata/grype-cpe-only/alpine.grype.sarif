              },
              "properties": {
                "purls": [
                  "pkg:apk/alpine/sqlite-libs@3.49.2-r1?arch=x86_64\u0026distro=alpine-3.22.8\u0026upstream=sqlite"
                ],
                "security-severity": "8.5"
              }
            },
            {
              "id": "CVE-2026-11822-sqlite-libs",
              "name": "ApkMatcherCpeMatch",
              "shortDescription": {
                "text": "CVE-2026-11822 medium vulnerability for sqlite-libs package"
              },
              "fullDescription": {
                "text": "SQLite before 3.53.2 contains an out-of-bounds read vulnerability in the FTS5 full-text search extension that allows attackers to crash the process by supplying a crafted database with a malformed FTS5 leaf page. Attackers can set an oversized term length in the leaf page so that fts5LeafSeek() reads past the end of the page buffer while comparing terms during an FTS5 MATCH query, in applications compiled with SQLITE_ENABLE_FTS5."
              },
              "helpUri": "https://nvd.nist.gov/vuln/detail/CVE-2026-11822",
              "help": {
                "text": "Vulnerability CVE-2026-11822\nSeverity: medium\nPackage: sqlite-libs\nVersion: 3.49.2-r1\nFix Version: \nType: apk\nLocation: /lib/apk/db/installed\nData Namespace: nvd:cpe\nLink: [CVE-2026-11822](https://nvd.nist.gov/vuln/detail/CVE-2026-11822)",
