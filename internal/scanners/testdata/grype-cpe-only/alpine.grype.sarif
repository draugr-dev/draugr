            {
              "id": "CVE-2026-119376-sqlite-libs",
              "name": "ApkMatcherCpeMatch",
              "shortDescription": {
                "text": "CVE-2026-119376 medium vulnerability for sqlite-libs package"
              },
              "fullDescription": {
                "text": "SQLite before 3.54.0 contains a stack exhaustion vulnerability that allows attackers to bypass the SQLITE_LIMIT_EXPR_DEPTH limit by chaining COLLATE postfix operators. Attackers can supply roughly 175,000 chained COLLATE operators in SQL or an untrusted database view to trigger unbounded recursion in sqlite3WalkExprNN() and crash the process."
              },
              "helpUri": "https://nvd.nist.gov/vuln/detail/CVE-2026-119376",
