tabilityScore":2.9,"impactScore":3.6},"vendorMetadata":{}},{"source":"security-advisories@github.com","type":"Secondary","version":"3.1","vector":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:C/C:H/I:N/A:N","metrics":{"baseScore":7.7,"exploitabilityScore":3.2,"impactScore":4},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2023-36826","epss":0.00634,"percentile":0.50527,"date":"2026-11-05"}],"cwes":[{"cve":"CVE-2023-36826","cwe":"CWE-285","source":"security-advisories@github.com","type":"Secondary"},{"cve":"CVE-2023-36826","cwe":"CWE-863","source":"security-advisories@github.com","type":"Secondary"},{"cve":"CVE-2023-36826","cwe":"CWE-863","source":"nvd@nist.gov","type":"Primary"}],"fix":{"versions":["23.5.2"],"state":"fixed","available":[{"version":"23.5.2","date":"2025-09-04","kind":"first-observed"}]},"advisories":[],"risk":0.38357},"relatedVulnerabilities":[],"matchDetails":[{"type":"cpe-match","matcher":"stock-matcher","searchedBy":{"namespace":"nvd:cpe","cpes":["cpe:2.3:a:sentry:sentry:9.6.0:*:*:*:*:*:*:*"],"package":{"name":"sentry","version":"9.6.0"}},"found":{"vulnerabilityID":"CVE-2023-36826","versionConstraint":">= 8.21.0, < 23.5.2 (unknown)","cpes":["cpe:2.3:a:sentry:sentry:*:*:*:*:*:*:*:*"]},"fix":{"suggestedVersion":"23.5.2"}}],"artifact":{"id":"26b1441eb1784db8","name":"sentry","version":"9.6.0","type":"dart-pub","locations":[{"path":"/pubspec.lock","accessPath":"/pubspec.lock","annotations":{"evidence":"primary"}}],"language":"dart","licenses":[],"cpes":["cpe:2.3:a:sentry:sentry:9.6.0:*:*:*:*:*:*:*"],"purl":"pkg:pub/sentry@9.6.0?hosted_url=pub.dev","upstreams":[]}},{"vulnerability":{"id":"CVE-2024-24829","dataSource":"https://nvd.nist.gov/vuln/detail/CVE-2024-24829","namespace":"nvd:cpe","severity":"Medium","urls":["https://github.com/getsentry/self-hosted/releases/tag/24.1.2","https://github.com/getsentry/sentry/pull/64882","https://github.com/getsentry/sentry/security/advisories/GHSA-rqxh-fp9p-p98r"],"description":"Sentry is an error tracking and performance monitoring platform. Sentry’s integration platform provides a way for external services to interact with Sentry. One of such integrations, the Phabricator integration (maintained by Sentry) with version <=24.1.1 contains a constrained SSRF vulnerability. An attacker could make Sentry send POST HTTP requests to arbitrary URLs (including internal IP addresses) by providing an unsanitized input to the Phabricator integration. However, the body payload is constrained to a specific format. If an attacker has access to a Sentry instance, this allows them to: 1. interact with internal network; 2. scan local/remote ports. This issue has been fixed in Sentry self-hosted release 24.1.2, and has already been mitigated on sentry.io on February 8. Users are advised to upgrade. There are no known workarounds for this vulnerability.","cvss":[{"source":"nvd@nist.gov","type":"Primary","version":"3.1","vector":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:L/I:N/A:N","metrics":{"baseScore":5.3,"exploitabilityScore":3.9,"impactScore":1.5},"vendorMetadata":{}},{"source":"security-advisories@github.com","type":"Secondary","version":"3.1","vector":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:L/I:N/A:N","metrics":{"baseScore":4.3,"exploitabilityScore":2.9,"impactScore":1.5},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2024-24829","epss":0.0047,"percentile":0.40765,"date":"2026-11-05"}],"cwes":[{"cve":"CVE-2024-24829","cwe":"CWE-918","source":"security-advisories@github.com","type":"Secondary"},{"cve":"CVE-2024-24829","cwe":"CWE-918","source":"nvd@nist.gov","type":"Primary"}],"fix":{"versions":["24.1.2"],"state":"fixed","available":[{"version":"24.1.2","date":"2025-09-04","kind":"first-observed"}]},"advisories":[],"risk":0.2303},"relatedVulnerabilities":[],"matchDetails":[{"type":"cpe-match","matcher":"stock-matcher","searchedBy":{"namespace":"nvd:cpe","cpes":["cpe:2.3:a:sentry:sentry:9.6.0:*:*:*:*:*:*:*"],"package":{"name":"sentry","version":"9.6.0"}},"found":{"vulnerabilityID":"CVE-2024-24829","versionConstraint":">= 9.