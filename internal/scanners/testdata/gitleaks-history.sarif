{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "gitleaks",
          "semanticVersion": "v8.0.0",
          "informationUri": "https://github.com/gitleaks/gitleaks",
          "rules": [
            {
              "id": "github-pat",
              "shortDescription": {
                "text": "Uncovered a GitHub Personal Access Token, potentially leading to unauthorized repository access and sensitive content exposure."
              }
            }
          ]
        }
      },
      "results": [
        {
          "message": {
            "text": "github-pat has detected secret for file deploy.env at commit 4dd0b35ce7497770369b24c3e860be3954b27b3c."
          },
          "ruleId": "github-pat",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "deploy.env"
                },
                "region": {
                  "startLine": 1,
                  "startColumn": 14,
                  "endLine": 1,
                  "endColumn": 53,
                  "snippet": {
                    "text": "__TOKEN__"
                  }
                }
              }
            }
          ],
          "partialFingerprints": {
            "commitSha": "4dd0b35ce7497770369b24c3e860be3954b27b3c",
            "email": "jane.doe@example.com",
            "author": "Jane Doe",
            "date": "2026-10-05T05:47:11Z",
            "commitMessage": "temporary token for the release job"
          },
          "properties": {
            "tags": []
          }
        }
      ]
    }
  ]
}
