              "id": "CVE-2022-42889-commons-text",
              "name": "JavaMatcherExactDirectMatch",
              "shortDescription": {
                "text": "CVE-2022-42889 critical vulnerability for commons-text package"
              },
              "fullDescription": {
                "text": "Arbitrary code execution in Apache Commons Text"
              },
              "helpUri": "https://github.com/advisories/GHSA-599f-7c49-w659",
              "help": {
                "text": "Vulnerability CVE-2022-42889\nSeverity: critical\nPackage: commons-text\nVersion: 1.9\nFix Version: 1.10.0\nType: java-archive\nLocation: /service/pom.xml\nData Namespace: github:language:java\nLink: [CVE-2022-42889](https://github.com/advisories/GHSA-599f-7c49-w659)",
                "markdown": "**Vulnerability CVE-2022-42889**\n| Severity | Package | Version | Fix Version | Type | Location | Data Namespace | Link |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| critical  | commons-text  | 1.9  | 1.10.0  | java-archive  | /service/pom.xml  | github:language:java  | [CVE-2022-42889](https://github.com/advisories/GHSA-599f-7c49-w659)  |\n"
              },
              "properties": {
                "purls": [
                  "pkg:maven/org.apache.commons/commons-text@1.9"
                ],
                "security-severity": "9.8"
              }
            },
