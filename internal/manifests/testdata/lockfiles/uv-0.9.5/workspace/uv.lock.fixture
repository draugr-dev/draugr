version = 1
revision = 3
requires-python = ">=3.13"

[manifest]
members = [
    "a",
    "b",
    "mono",
]

[[package]]
name = "a"
version = "0.1.0"
source = { editable = "packages/a" }

[[package]]
name = "b"
version = "0.1.0"
source = { editable = "packages/b" }

[[package]]
name = "mono"
version = "0.1.0"
source = { virtual = "." }
dependencies = [
    { name = "a" },
    { name = "b" },
]

[package.metadata]
requires-dist = [
    { name = "a", editable = "packages/a" },
    { name = "b", editable = "packages/b" },
]
