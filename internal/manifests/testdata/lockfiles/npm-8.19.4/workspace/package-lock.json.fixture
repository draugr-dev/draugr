{
  "name": "mono",
  "version": "1.0.0",
  "lockfileVersion": 2,
  "requires": true,
  "packages": {
    "": {
      "name": "mono",
      "version": "1.0.0",
      "workspaces": [
        "packages/*"
      ]
    },
    "node_modules/a": {
      "resolved": "packages/a",
      "link": true
    },
    "node_modules/b": {
      "resolved": "packages/b",
      "link": true
    },
    "packages/a": {
      "version": "1.0.0"
    },
    "packages/b": {
      "version": "1.0.0",
      "dependencies": {
        "a": "1.0.0"
      }
    }
  },
  "dependencies": {
    "a": {
      "version": "file:packages/a"
    },
    "b": {
      "version": "file:packages/b",
      "requires": {
        "a": "1.0.0"
      }
    }
  }
}
