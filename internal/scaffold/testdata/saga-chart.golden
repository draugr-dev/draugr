# yaml-language-server: $schema=https://draugr.dev/schema/draugr.saga.schema.json
# Generated by `draugr init`. Edit to taste, then: draugr scan draugr.saga.yaml
project: shop
config:
  controls:
    sca:
      enabled: true       # dependency vulnerabilities (Trivy)
    secrets:
      enabled: true       # leaked credentials (Gitleaks)
    sast:
      enabled: true       # code security (Semgrep)
    iac:
      enabled: true       # IaC misconfiguration (Trivy config) · .
components:
  - name: shop
    repositories:
      - url: .
        # ignore:
          # Documentation, examples and tests. Their findings are labeled and listed after
          # the shipped code's. Uncommenting a line stops every control reading it, secrets too.
          # - "**/testdata"   # tests · internal/render/testdata · internal/values/testdata
          # - docs/           # documentation
          # - tests/          # tests
    # hosts:            # for the headers/DAST controls
    #   - name: api
    #     url: https://api.example.com
    #     type: api
