# yaml-language-server: $schema=https://draugr.dev/schema/draugr.saga.schema.json
# Generated by `draugr init`. Edit to taste, then: draugr scan draugr.saga.yaml
project: shop
config:
  reachability:
    analyzers: [govulncheck]   # ranks a Go finding down when no code calls it · go.mod · services/api/go.mod
  controls:
    sca:
      enabled: true       # dependency vulnerabilities (Trivy)
      trivyFs:
        filePatterns: ['pip:requirements[^/]*\.txt$']   # requirements files under other names · requirements-dev.txt
    secrets:
      enabled: true       # leaked credentials (Gitleaks)
    sast:
      enabled: true       # code security (Semgrep)
      gosec:
        enabled: true     # Go-specific checks · go.mod · services/api/go.mod
    iac:
      enabled: true       # IaC misconfiguration (Trivy config) · web/Dockerfile
    # images:
    #   enabled: true     # container CVEs (Trivy). Add your built image below
components:
  - name: shop
    repositories:
      - url: .
        ignore: [services/api/, web/]
    # hosts:            # for the headers/DAST controls
    #   - name: api
    #     url: https://api.example.com
    #     type: api
  - name: api
    repositories:
      - url: .
        paths: [services/api]
        ignore: [services/api/worker/]
  - name: worker
    repositories:
      - url: .
        paths: [services/api/worker]
    # Unread · services/api/worker/package.json no lockfile · its packages are not checked
  - name: web
    repositories:
      - url: .
        paths: [web]
    # images:
    #   - image: myorg/web:latest
