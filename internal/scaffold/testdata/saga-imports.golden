# yaml-language-server: $schema=https://draugr.dev/schema/draugr.saga.schema.json
# Generated by `draugr init`. Edit to taste, then: draugr scan draugr.saga.yaml
project: shop
config:
  detect: true   # turns on the controls the files call for, which draugr doctor names
components:
  - name: shop
    repositories:
      - url: .
    # imports:          # SARIF another tool wrote. Uncommenting one changes what a scan reads
    #   - control: sast   # Fortify, a tool init does not know · check the control · in the tree
    #     file: reports/legacy.sarif
    #   - control: sast   # Semgrep · in the tree
    #     file: reports/semgrep.sarif
    #   - control: iac    # Checkov · .github/workflows/scan.yml
    #     file: ""   # the step names no file · point it at where the CI writes one; an import reads a local file
    #   - control: sast   # CodeQL · .github/workflows/scan.yml
    #     file: ""   # the step names no file · point it at where the CI writes one; an import reads a local file
    #   - control: sca    # Trivy · .github/workflows/scan.yml
    #     file: trivy.sarif   # not in the tree · point it at where the CI writes it; an import reads a local file
