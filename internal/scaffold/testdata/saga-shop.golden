# yaml-language-server: $schema=https://draugr.dev/schema/draugr.saga.schema.json
# Generated by `draugr init`. Edit to taste, then: draugr scan draugr.saga.yaml
project: shop
config:
  reachability:
    analyzers: [govulncheck]   # ranks a Go finding down when no code calls it · go.mod
  controls:
    sca:
      enabled: true       # dependency vulnerabilities (Trivy)
      retirejs:
        enabled: true     # copied JavaScript, outside any lockfile · web/static/jquery-1.8.3.min.js
      grypeFs:
        enabled: true     # Trivy does not read setup.py · ml/setup.py
    secrets:
      enabled: true       # leaked credentials (Gitleaks)
    sast:
      enabled: true       # code security (Semgrep)
      gosec:
        enabled: true     # Go-specific checks · go.mod
    iac:
      enabled: true       # IaC misconfiguration (Trivy config) · deploy/terraform · deploy/chart · Dockerfile
    # images:
    #   enabled: true     # container CVEs (Trivy). Add your built image below
components:
  - name: shop
    repositories:
      - url: .
    # Unread · web/package.json no lockfile · its packages are not checked
    # Directories with their own dependency files: ml · web
    # `draugr init --per-directory` writes a component for each.
    # images:
    #   - image: myorg/shop:latest
    # hosts:            # for the headers/DAST controls
    #   - name: api
    #     url: https://api.example.com
    #     type: api
    #     spec:
    #       path: ./api/openapi.yaml
