# Build artifacts
/bin/
dist/

# Test / coverage output
*.out

# Scan output. The self-scan writes here, and examples/reporting.saga.yaml names it — so it
# appears in a working tree routinely, and `*.out` above does not match a directory called
# Everything a scan writes lives under .draugr/, beside the descriptor and the exclusions it
# already keeps there. draugr-out/ and .draugr-out/ are the names that came before.
.draugr/out/
.draugr/cache/
draugr-out/
.draugr-out/
coverage.*

# Release notes generated in CI from CHANGELOG (keeps the tree clean for GoReleaser)
/RELEASE_NOTES.md

# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/

# Signing key for MCP Registry publishing. Generated locally, never committed —
# whoever holds it can publish under our namespace.
key.pem
*.pem
contrib/mcpb/server.json
