{
  "manifest_version": "0.3",
  "name": "draugr",
  "display_name": "Draugr",
  "version": "__VERSION__",
  "description": "Security scanning for AI agents: SAST, SCA, secrets, IaC, DAST, ranked by real risk.",
  "long_description": "Ask a coding assistant whether a change is safe to ship and it will answer either way \u2014 usually by running whatever scanner it can find over a scope it invented. Draugr gives it the same answer your pipeline would give, because it reads the same committed descriptor and applies the same controls: SAST, SCA, secrets, IaC and DAST, deduplicated across tools, normalized to SARIF, and ranked P1-P4 by the component's declared exposure and criticality rather than by raw severity. Over MCP it serves the read-only half: which controls exist, the descriptor schema this build enforces, whether a descriptor is valid, which scanners are installed and what to run if one is missing, and an existing report ranked by priority. It installs nothing and scans nothing unless the operator turns scanning on.",
  "author": {
    "name": "Draugr",
    "url": "https://draugr.dev"
  },
  "icon": "icon.png",
  "homepage": "https://draugr.dev",
  "documentation": "https://draugr.dev/docs/latest/guides/ai-agents-mcp/",
  "support": "https://github.com/draugr-dev/draugr/issues",
  "license": "Apache-2.0",
  "keywords": ["security", "sast", "sca", "sarif", "devsecops", "vulnerability"],
  "repository": {
    "type": "git",
    "url": "https://github.com/draugr-dev/draugr"
  },
  "server": {
    "type": "binary",
    "entry_point": "server/draugr-linux-amd64",
    "mcp_config": {
      "command": "${__dirname}/server/draugr-linux-amd64",
      "args": ["mcp"],
      "env": {},
      "platform_overrides": {
        "darwin": {
          "command": "${__dirname}/server/draugr-darwin",
          "args": ["mcp"]
        },
        "win32": {
          "command": "${__dirname}/server/draugr.exe",
          "args": ["mcp"]
        }
      }
    }
  },
  "tools": __TOOLS__,
  "compatibility": {
    "platforms": ["darwin", "win32", "linux"]
  }
}
